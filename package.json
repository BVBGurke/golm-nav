{
  "name": "golm-nav",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "oxlint",
    "data:fetch": "node scripts/fetch_osm.mjs",
    "data:build": "node scripts/build_campus.mjs && node scripts/dump_places.mjs && node scripts/build_pois.mjs src",
    "data:bits": "node scripts/extract_bits.mjs src",
    "data": "npm run data:build",
    "serve": "node scripts/serve.mjs",
    "shots": "node docs/capture.mjs",
    "check:routes": "node docs/check-routes.mjs"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@hugeicons/core-free-icons": "^4.3.5",
    "@hugeicons/react": "^1.1.10",
    "gsap": "^3.15.0",
    "maplibre-gl": "^6.14.0",
    "motion": "^14.3.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "playwright-core": "^1.64.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  },
  "description": "Navigationssystem für den Campus Golm der Universität Potsdam – alle Häuser auf einer Karte, Live-Route im Browser."
}
